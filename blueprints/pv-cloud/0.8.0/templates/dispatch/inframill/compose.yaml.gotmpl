services:
  inframill:
    image: {{ toJSON .inframill.image }}
    restart: unless-stopped
    entrypoint: ["/bin/sh", "/etc/inframill/entrypoint.sh"]
    network_mode: host
    secrets:
      - inframill_root_token
      - tls_private_key
    volumes:
      - inframill_data:/var/lib/inframill
      - ./inframill.yaml:/etc/inframill/inframill.yaml:ro
      - ./entrypoint.sh:/etc/inframill/entrypoint.sh:ro
      - ./healthcheck.py:/etc/inframill/healthcheck.py:ro
      - ./tls:/etc/inframill/tls:ro
      - ./ssh:/root/.ssh
      - ./blueprints:/opt/inframill/blueprints:ro
    healthcheck:
      test: ["CMD", "python3", "/etc/inframill/healthcheck.py"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 10s

secrets:
  inframill_root_token:
    file: ./secrets/root_token
  tls_private_key:
    file: ./secrets/tls_private_key

volumes:
  inframill_data:
