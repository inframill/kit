#cloud-config

preserve_hostname: false

# pv-cloud owns guest setup. Hetzner vendor-data contains deprecated password settings.
vendor_data:
  enabled: false

package_update: true
package_upgrade: true
disable_root: true
ssh_pwauth: false

users:
  - name: {{ toJSON .ssh.user }}
    gecos: {{ toJSON .ssh.user }}
    groups:
      - sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys: {{ toJSON .ssh.public_keys }}

write_files:
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    permissions: "0644"
    owner: root:root
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      AllowAgentForwarding no
      AllowTcpForwarding no

packages:
  - python3
  - sudo
  - ufw
  - vim
  - htop
  - curl
  - git
  - certbot
  - unzip
  - make

runcmd:
  # Show the full DNS hostname in the configured user's shell prompt.
  - systemctl restart ssh
