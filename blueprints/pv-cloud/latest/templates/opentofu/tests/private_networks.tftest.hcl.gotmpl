mock_provider "hcloud" {
  mock_resource "hcloud_network" { defaults = { id = "100" } }
  mock_resource "hcloud_server" { defaults = { id = "200", ipv4_address = "192.0.2.1" } }
  mock_data "hcloud_server_type" { defaults = { architecture = "x86", locations = [{name = "hel1", available = true, is_deprecated = false, deprecation_announced = "", id = 1, recommended = true, unavailable_after = ""}] } }
  mock_data "hcloud_image" { defaults = { architecture = "x86" } }
}

variables {
  private_networks = [{ name = "frontend", cidr = "10.40.1.0/24" }, { name = "database", cidr = "10.40.2.0/24" }]
  nodes = {
    web-1 = {
      architecture = "amd64"
      image = "ubuntu-24.04"
      location         = "hel1"
      server_type      = "cpx22"
      roles            = ["common", "web"]
      private_networks = ["frontend"]
    }
    data-1 = {
      architecture = "amd64"
      image = "ubuntu-24.04"
      location         = "hel1"
      server_type      = "cpx22"
      roles            = ["common", "data"]
      private_networks = ["frontend", "database"]
    }
    public-1 = {
      architecture = "amd64"
      image = "ubuntu-24.04"
      location         = "hel1"
      server_type      = "cpx22"
      roles            = ["common"]
      private_networks = []
    }
  }
}

run "valid_selective_attachments" {
  command = plan

  assert {
    condition     = hcloud_network.this["frontend"].name == "frontend-{{ .instance_name }}"
    error_message = "Provider Network names must be <network-name>-<instance-name>."
  }

  assert {
    condition     = length(hcloud_server_network.this) == 3
    error_message = "Terraform must create exactly the selected Node/Network attachments."
  }

  assert {
    condition     = output.inframill_nodes["public-1"].private_ipv4 == ""
    error_message = "A Node with no private Network must publish an empty canonical private address."
  }
}

run "valid_without_private_networks" {
  command = plan

  variables {
    private_networks = []
    nodes = {
      public-1 = {
        architecture = "amd64"
      image = "ubuntu-24.04"
      location         = "hel1"
        server_type      = "cpx22"
        roles            = ["common"]
        private_networks = []
      }
    }
  }

  assert {
    condition     = length(hcloud_network.this) == 0 && length(hcloud_server_network.this) == 0
    error_message = "An empty private Network list must create no Networks or attachments."
  }

  assert {
    condition     = output.inframill_nodes["public-1"].private_ipv4 == ""
    error_message = "A public-only Node must publish an empty canonical private address."
  }
}

run "arm64_target" {
  command = plan
  variables {
    private_networks = []
    nodes = {
      arm-1 = {
        location = "hel1"
        server_type = "cax11"
        architecture = "arm64"
        image = "ubuntu-24.04"
        roles = ["common"]
        private_networks = []
      }
    }
  }
  override_data {
    target = data.hcloud_server_type.selected
    values = {
      architecture = "arm"
      locations = [{name = "hel1", available = true, is_deprecated = false, deprecation_announced = "", id = 1, recommended = true, unavailable_after = ""}]
    }
  }
  override_data {
    target = data.hcloud_image.selected
    values = { architecture = "arm" }
  }
  assert {
    condition = output.inframill_nodes["arm-1"].architecture == "arm64"
    error_message = "ARM64 target architecture must be preserved."
  }
}

run "reject_provider_architecture_mismatch" {
  command = plan
  variables {
    private_networks = []
    nodes = {
      arm-1 = {
        location = "hel1"
        server_type = "cax11"
        architecture = "arm64"
        image = "ubuntu-24.04"
        roles = ["common"]
        private_networks = []
      }
    }
  }
  expect_failures = [hcloud_server.this]
}
