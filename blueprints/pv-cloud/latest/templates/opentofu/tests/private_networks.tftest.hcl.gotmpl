mock_provider "hcloud" {
  mock_resource "hcloud_network" { defaults = { id = "100" } }
  mock_resource "hcloud_server" { defaults = { id = "200", ipv4_address = "192.0.2.1" } }
  mock_data "hcloud_server_type" { defaults = { architecture = "x86", locations = [{name = "hel1", available = true, is_deprecated = false, deprecation_announced = "", id = 1, recommended = true, unavailable_after = ""}] } }
  mock_data "hcloud_image" { defaults = { architecture = "x86" } }
}

mock_provider "cloudflare" {
  mock_data "cloudflare_zone" {
    defaults = { name = "example.test" }
  }
}

variables {
  cloudflare_zone_id = "0123456789abcdef0123456789abcdef"
  private_networks = [{ name = "frontend", cidr = "10.40.1.0/24" }, { name = "database", cidr = "10.40.2.0/24" }]
  nodes = {
    web-1 = {
      architecture = "amd64"
      image = "ubuntu-24.04"
      location         = "hel1"
      server_type      = "cpx22"
      roles            = ["common", "web"]
      private_networks = ["frontend"]
    }
    data-1 = {
      architecture = "amd64"
      image = "ubuntu-24.04"
      location         = "hel1"
      server_type      = "cpx22"
      roles            = ["common", "data"]
      private_networks = ["frontend", "database"]
    }
    public-1 = {
      architecture = "amd64"
      image = "ubuntu-24.04"
      location         = "hel1"
      server_type      = "cpx22"
      roles            = ["common"]
      private_networks = []
    }
  }
}

run "valid_selective_attachments" {
  command = plan

  assert {
    condition = length(hcloud_firewall.postgres) == 1 && one(hcloud_firewall.postgres[0].apply_to).label_selector == "app=${local.app},role-data=true"
    error_message = "PostgreSQL ingress must select only data nodes in this Instance."
  }

  assert {
    condition = hcloud_server.this["data-1"].labels["role-data"] == "true" && hcloud_server.this["web-1"].labels["role-data"] == "false"
    error_message = "Node roles must control PostgreSQL firewall membership."
  }

  assert {
    condition     = hcloud_network.this["frontend"].name == {{ toJSON (printf "frontend-%s" (instance).Name) }}
    error_message = "Provider Network names must be <network-name>-<instance-name>."
  }

  assert {
    condition     = length(hcloud_server_network.this) == 3
    error_message = "Terraform must create exactly the selected Node/Network attachments."
  }

  assert {
    condition     = output.inframill_nodes["public-1"].private_ipv4 == ""
    error_message = "A Node with no private Network must publish an empty canonical private address."
  }
}

run "valid_without_private_networks" {
  command = plan

  variables {
    private_networks = []
    nodes = {
      public-1 = {
        architecture = "amd64"
      image = "ubuntu-24.04"
      location         = "hel1"
        server_type      = "cpx22"
        roles            = ["common"]
        private_networks = []
      }
    }
  }

  assert {
    condition     = length(hcloud_network.this) == 0 && length(hcloud_server_network.this) == 0
    error_message = "An empty private Network list must create no Networks or attachments."
  }

  assert {
    condition = length(hcloud_firewall.postgres) == 0
    error_message = "Instances without data nodes must not create PostgreSQL ingress."
  }

  assert {
    condition     = output.inframill_nodes["public-1"].private_ipv4 == ""
    error_message = "A public-only Node must publish an empty canonical private address."
  }
}

run "postgres_external_sources" {
  command = plan
  variables {
    postgres = { port = 55432, source_ips = ["192.0.2.0/24", "2001:db8::/32"] }
  }
  assert {
    condition = one(hcloud_firewall.postgres[0].rule).port == "55432" && toset(one(hcloud_firewall.postgres[0].rule).source_ips) == toset(["192.0.2.0/24", "2001:db8::/32"])
    error_message = "The PostgreSQL firewall must use the configured port and IPv4/IPv6 source CIDRs."
  }
}

run "postgres_invalid_source" {
  command = plan
  variables {
    postgres = { source_ips = ["invalid"] }
  }
  expect_failures = [var.postgres]
}

run "arm64_target" {
  command = plan
  variables {
    private_networks = []
    nodes = {
      arm-1 = {
        location = "hel1"
        server_type = "cax11"
        architecture = "arm64"
        image = "ubuntu-24.04"
        roles = ["common"]
        private_networks = []
      }
    }
  }
  override_data {
    target = data.hcloud_server_type.selected
    values = {
      architecture = "arm"
      locations = [{name = "hel1", available = true, is_deprecated = false, deprecation_announced = "", id = 1, recommended = true, unavailable_after = ""}]
    }
  }
  override_data {
    target = data.hcloud_image.selected
    values = { architecture = "arm" }
  }
  assert {
    condition = output.inframill_nodes["arm-1"].architecture == "arm64"
    error_message = "ARM64 target architecture must be preserved."
  }
}

run "reject_provider_architecture_mismatch" {
  command = plan
  variables {
    private_networks = []
    nodes = {
      arm-1 = {
        location = "hel1"
        server_type = "cax11"
        architecture = "arm64"
        image = "ubuntu-24.04"
        roles = ["common"]
        private_networks = []
      }
    }
  }
  expect_failures = [hcloud_server.this]
}

run "node_name_does_not_assign_roles" {
  command = plan
  variables {
    private_networks = []
    nodes = {
      data = {
        location = "hel1"
        server_type = "cpx22"
        architecture = "amd64"
        image = "ubuntu-24.04"
        roles = ["docker"]
        private_networks = []
      }
    }
  }
  assert {
    condition = join(",", output.inframill_nodes["data"].roles) == "docker"
    error_message = "Node names must not assign roles."
  }
  assert {
    condition = hcloud_server.this["data"].labels.node == "data" && !can(hcloud_server.this["data"].labels.role)
    error_message = "Node names must only appear in the node identity label."
  }
}

run "reject_reserved_inventory_names" {
  command = plan
  variables {
    private_networks = []
    nodes = {
      all = {
        location = "hel1"
        server_type = "cpx22"
        architecture = "amd64"
        image = "ubuntu-24.04"
        roles = ["docker"]
        private_networks = []
      }
    }
  }
  expect_failures = [var.nodes]
}

run "node_dns_records" {
  command = apply
  variables {
    private_networks = []
    nodes = {
      data = {
        location = "hel1"
        server_type = "cpx22"
        architecture = "amd64"
        image = "ubuntu-24.04"
        roles = ["docker"]
        private_networks = []
      }
      worker = {
        location = "hel1"
        server_type = "cpx22"
        architecture = "amd64"
        image = "ubuntu-24.04"
        roles = ["docker"]
        private_networks = []
      }
    }
  }
  assert {
    condition = length(cloudflare_dns_record.node) == 2
    error_message = "Every node must have exactly one DNS record."
  }
  assert {
    condition = cloudflare_dns_record.node["data"].name == lower({{ toJSON (printf "data-%s.example.test" (instance).ID) }}) && cloudflare_dns_record.node["worker"].name == lower({{ toJSON (printf "worker-%s.example.test" (instance).ID) }})
    error_message = "DNS names must contain the node name and immutable Instance ID."
  }
  assert {
    condition = alltrue([for name, record in cloudflare_dns_record.node : record.content == hcloud_server.this[name].ipv4_address])
    error_message = "A records must point to the matching node's public IPv4."
  }
  assert {
    condition = alltrue([for record in cloudflare_dns_record.node : record.type == "A" && record.zone_id == var.cloudflare_zone_id && record.ttl == 60 && record.proxied == false])
    error_message = "Node records must be DNS-only A records in the configured zone."
  }
  assert {
    condition = output.server_fqdns["data"] == cloudflare_dns_record.node["data"].name && output.inframill_nodes["worker"].fqdn == cloudflare_dns_record.node["worker"].name
    error_message = "DNS names must be published in server outputs and shared node records."
  }
}

run "reject_invalid_dns_label" {
  command = plan
  variables {
    private_networks = []
    nodes = {
      bad_name = {
        location = "hel1"
        server_type = "cpx22"
        architecture = "amd64"
        image = "ubuntu-24.04"
        roles = ["docker"]
        private_networks = []
      }
    }
  }
  expect_failures = [var.nodes]
}
