{
  "schemaVersion": 1,
  "version": "0.1.25-dev",
  "build": {
    "name": "kit-exec",
    "versionVariable": "main.version",
    "steps": [
      {
        "exec": [
          "task",
          "build:prepare"
        ]
      },
      {
        "toolai": [
          "go",
          "build"
        ]
      },
      {
        "toolai": [
          "go",
          "build",
          "--native",
          "--output",
          "bin/kit-exec"
        ]
      },
      {
        "exec": [
          "task",
          "build:engine"
        ],
        "env": {
          "TOOLAI": "${toolaiExecutable}"
        }
      },
      {
        "exec": [
          "task",
          "build:image"
        ]
      },
      {
        "exec": [
          "task",
          "build:release"
        ],
        "tags": [
          "release"
        ]
      }
    ]
  },
  "gopackage": [
    {
      "package": "./internal/artifacts",
      "mode": "stdlib"
    },
    {
      "package": "./internal/toolrun",
      "mode": "pure"
    }
  ],
  "checks": {
    "steps": [
      {
        "toolai": [
          "go",
          "mod",
          "tidy",
          "-diff"
        ]
      },
      {
        "toolai": [
          "gopackage",
          "check"
        ]
      },
      {
        "toolai": [
          "go",
          "compile"
        ]
      },
      {
        "toolai": [
          "go",
          "vet"
        ]
      },
      {
        "toolai": [
          "go",
          "test"
        ]
      },
      {
        "exec": [
          "task",
          "check:python"
        ]
      },
      {
        "toolai": [
          "go",
          "mod",
          "verify"
        ],
        "tags": [
          "full"
        ]
      },
      {
        "toolai": [
          "go",
          "compile",
          "--build-tags",
          "testproviders"
        ],
        "tags": [
          "full"
        ]
      },
      {
        "toolai": [
          "go",
          "vet",
          "--build-tags",
          "testproviders"
        ],
        "tags": [
          "full"
        ]
      },
      {
        "toolai": [
          "go",
          "test",
          "--race",
          "--coverage",
          "--shuffle",
          "on"
        ],
        "tags": [
          "full"
        ]
      },
      {
        "exec": [
          "task",
          "test:native"
        ],
        "tags": [
          "full",
          "native"
        ]
      },
      {
        "exec": [
          "task",
          "test:image"
        ],
        "tags": [
          "full",
          "image"
        ]
      },
      {
        "toolai": [
          "go",
          "lint",
          "--build-tags",
          "testproviders"
        ],
        "tags": [
          "lint"
        ]
      }
    ]
  }
}
