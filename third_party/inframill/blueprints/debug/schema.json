{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "message": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "success",
        "fail",
        "block"
      ],
      "default": "success"
    },
    "secret_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
