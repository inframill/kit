# Hetzner Object Storage (S3-compatible). Credentials come from
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, resolved from
# Instance value references through the Blueprint manifest — never hardcode them here.
terraform {
  backend "s3" {
    key    = "projects/{{ .hcproj }}/pv-clouds/{{ .instance_name }}/terraform.tfstate"
    region = "{{ .infra_state_bucket.region }}"

    endpoints                   = { s3 = "https://{{ .infra_state_bucket.host }}" }
    skip_credentials_validation = true
    skip_metadata_api_check     = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
    use_path_style              = {{ toJSON .infra_state_bucket.use_path_style }}
  }
}
