{
  "title": "pv-cloud Instance",
  "type": "object",
  "required": [
    "hcproj",
    "private_networks",
    "ssh_user",
    "ssh_public_keys",
    "nodes",
    "infra_state_bucket",
    "instance_name"
  ],
  "properties": {
    "hcproj": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "private_networks": {
      "type": "array",
      "x-inframill-validations": [
        {
          "function": "unique",
          "select": "name"
        },
        {
          "function": "cidr",
          "select": "cidr",
          "version": 4,
          "scope": "private",
          "canonical": true
        },
        {
          "function": "cidr_disjoint",
          "select": "cidr"
        }
      ],
      "items": {
        "$ref": "#/$defs/private_network"
      }
    },
    "ssh_user": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
    },
    "ssh_public_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( [A-Za-z0-9@._-]+)?$"
      }
    },
    "ansible": {
      "type": "object",
      "properties": {
        "address_type": {
          "type": "string",
          "pattern": "^(fqdn|ipv4_public|ipv4_private)$",
          "default": "ipv4_public"
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "infra_state_bucket": {
      "type": "object",
      "required": [
        "bucket",
        "access_key_ref",
        "secret_key_ref",
        "host",
        "region",
        "use_path_style"
      ],
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "use_path_style": {
          "type": "boolean"
        },
        "access_key_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "secret_key_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "instance_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "private_network": {
      "type": "object",
      "required": [
        "name",
        "cidr"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "cidr": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "location",
        "server_type",
        "roles",
        "private_networks"
      ],
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1
        },
        "server_type": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(common|web|data)$"
          }
        },
        "private_networks": {
          "type": "array",
          "x-inframill-validations": [
            {
              "function": "unique"
            },
            {
              "function": "references",
              "target": "private_networks",
              "target_select": "name"
            }
          ],
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
